# Trakt API Configuration
# Get your API key from: https://trakt.tv/oauth/applications
TRAKT_API_KEY=your_trakt_api_key_here

# TMDB API Configuration (Optional - for movie posters)
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# AI Provider Configuration (Optional - for AI features)
# Choose one provider and set the corresponding API key/model
# AI_PROVIDER options: gemini | openai | groq
AI_PROVIDER=

# Generic AI settings (optional fallback)
AI_API_KEY=
AI_MODEL=

# Gemini (Google) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://cinematec_user:cinematec_password@localhost:5432/cinematec_explorer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinematec_explorer
DB_USER=cinematec_user
DB_PASSWORD=cinematec_password

# TTS Configuration (Optional)
TTS_ENABLED=true
TTS_VOICE=en-US-AriaNeural
TTS_RATE=1.0
TTS_PITCH=1.0